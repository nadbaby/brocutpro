rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Main Inventory, Rail Stock, Categories, and Cut Logs
    match /inventory/{docId} {
      allow read, write: if true;
    }
    
    // User Accounts and Authentication Roles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
